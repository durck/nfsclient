# Force LF line endings for Go source so gofmt -l passes on all platforms.
*.go    text eol=lf
*.mod   text eol=lf
*.sum   text eol=lf
*.sh    text eol=lf
*.py    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.json  text eol=lf

# Binary assets — no EOL conversion
*.png   binary
*.gif   binary
*.cast  text eol=lf
