# Force LF line endings for Go source so gofmt -l passes on all platforms.
.gitattributes text eol=lf
.gitignore     text eol=lf
.dockerignore  text eol=lf
*.go    text eol=lf
*.mod   text eol=lf
*.sum   text eol=lf
*.sh    text eol=lf
*.py    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.json  text eol=lf

# Binary assets — no EOL conversion
*.png   binary
*.gif   binary
*.mp4   binary
*.cast  text eol=lf
