# Build context: repository root. All keys are generated by start.py at runtime.
FROM golang:1.26.8
ADD --checksum=sha256:221b3e224708c1da2a1a88b6824380593579b2254ae7d914afa14cbd5d343334 https://deb.debian.org/debian/pool/main/m/m4/m4_1.4.19-8_amd64.deb /tmp/m4.deb
ADD --checksum=sha256:ce6eb1f7aad18850e32d223a68f54bcbe756d74f138c8ec5460ad9d220f4d335 https://deb.debian.org/debian/pool/main/b/bison/bison_3.8.2+dfsg-1+b2_amd64.deb /tmp/bison.deb
ADD --checksum=sha256:f245b646a4fe5beb31d6a387da9db3399e3b14a904efef1a23227ff5465a1d11 https://deb.debian.org/debian/pool/main/o/openssl/libssl-dev_3.5.7-1~deb13u2_amd64.deb /tmp/libssl-dev.deb
ADD --checksum=sha256:3243ffbc8ea4d4ac22ddc7dd2a1dc54c57874c40648b60ff97009763554eaf13 https://web.mit.edu/kerberos/dist/krb5/1.22/krb5-1.22.2.tar.gz /tmp/krb5.tar.gz
RUN dpkg-deb -x /tmp/m4.deb / && dpkg-deb -x /tmp/bison.deb / && dpkg-deb -x /tmp/libssl-dev.deb / && ln -s bison /usr/bin/yacc
RUN mkdir /tmp/krb5 && tar xzf /tmp/krb5.tar.gz --strip-components=1 -C /tmp/krb5 && cd /tmp/krb5/src && ./configure --prefix=/opt/mit-pkinit --without-ldap --without-libedit --without-system-verto --enable-shared --disable-static --enable-pkinit CFLAGS=-fcommon && make -j4 && make install
ENV PATH=/opt/mit-pkinit/bin:/opt/mit-pkinit/sbin:$PATH
ENV LD_LIBRARY_PATH=/opt/mit-pkinit/lib
COPY internal/krbgss/native-helper/as-helper.c /tmp/as-helper.c
RUN cc -O2 -Wall -Wextra -Werror /tmp/as-helper.c $(krb5-config --cflags --libs) -o /opt/nfs-viewer-as-helper
COPY tests/kerberos-pkinit/start.py /start.py
CMD ["python3", "/start.py"]
